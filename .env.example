# Copy to .env.local and fill in. Never commit real values.

# --- Public (shipped to the browser; safe only because RLS protects all data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of this app, e.g. http://localhost:3000 or https://wemuste.com
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile site key. Leave empty locally to hide the widget
# (Supabase captcha protection must then be off for local development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# MapTiler key (https://cloud.maptiler.com/account/keys). Public by design:
# restrict it to your domains in MapTiler. Used for map tiles and place search.
NEXT_PUBLIC_GEOCODING_API_KEY=
# Optional: raster tile URLs ({key} is replaced with the key above) and credit.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/pastel/256/{z}/{x}/{y}{r}.png?key={key}
# NEXT_PUBLIC_MAP_TILE_URL_DARK=https://api.maptiler.com/maps/dataviz-dark/256/{z}/{x}/{y}{r}.png?key={key}
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`).
# Used to HMAC IP addresses and rate-limit keys so raw IPs are never stored.
IP_HASH_SECRET=
# Transactional email via Resend (https://resend.com). Sender must be a verified domain.
RESEND_API_KEY=
EMAIL_FROM="Wemuste <no-reply@your-domain.com>"
# Local development only: send app emails to the Mailpit inbox instead of Resend.
# SMTP_URL=smtp://127.0.0.1:54325
# Cloudflare Turnstile secret for public applications (required in production).
# Local development: the test keys 1x00000000000000000000AA (site key) and
# 1x0000000000000000000000000000000AA (secret) always pass.
TURNSTILE_SECRET_KEY=
# Random, at least 32 characters (`openssl rand -base64 48`): hashes application tokens.
APP_TOKEN_SECRET=
# Random, at least 16 characters: Vercel Cron authenticates /api/cron/cleanup with it.
CRON_SECRET=
# Receives "new application" notices (no personal data in them).
ADMIN_NOTIFY_EMAIL=
# "true" asks applicants for a phone code (needs an SMS provider in src/server/public-application/otp.ts).
REQUIRE_PHONE_OTP=false
# Optional: limit where sponsors may place jobs, "south,west,north,east".
# Default: anywhere in the world. Example for the UAE only: 22.5,51.0,26.5,56.6
# JOB_AREA_BOUNDS=
